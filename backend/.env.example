PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (PostgreSQL)
# If local PostgreSQL is not available, SeatSync automatically runs with its built-in transactional memory store
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seatsync
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatsync
DB_USER=postgres
DB_PASSWORD=postgres

# Redis configuration
# If Redis is not available, SeatSync uses its built-in in-memory TTL lock manager
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=seatsync_super_secret_production_key_change_in_real_prod_2026
JWT_EXPIRES_IN=7d

# Concurrency & Booking Rules
MAX_SEATS_PER_BOOKING=6
LOCK_TTL_SECONDS=600
PAYMENT_TIMEOUT_SECONDS=180
